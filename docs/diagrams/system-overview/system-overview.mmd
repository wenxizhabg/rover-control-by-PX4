flowchart LR
    %% Khối đã có: người dùng và phần mềm không do nhóm viết
    user["Người vận hành"]
    px4["PX4 SITL - autopilot<br/>(Terminal A)"]
    gz["Gazebo - xe r1_rover<br/>(Terminal A)"]

    %% Khối đã có: code của nhóm (app rover, Terminal B)
    app["rover/app.py – RoverApp<br/>+ keymap, screen, terminal<br/>(US-04)"]
    am["rover/arm_control.py<br/>ArmControl (US-03a)"]
    lm["rover/link_monitor.py<br/>LinkMonitor (US-02)"]
    ml["rover/mavlink_link.py<br/>MavlinkVehicleLink<br/>(US-02, US-03a)"]
    vi["rover/vehicle_info.py<br/>parse_heartbeat (US-01)"]
    cli["rover/cli.py<br/>main, run_connect (US-01)"]
    conn["rover/connection.py<br/>connect (US-01)"]

    %% Khối dự kiến: US-03b, chưa vào sprint
    drv["Lái xe<br/>(US-03b, sau spike)"]

    %% Luồng chính khi người vận hành bấm R để mở khóa xe, số tăng dần theo thứ tự xảy ra (cạnh 0 đến 9)
    user -->|"1"| app
    app -->|"2"| am
    app -->|"3"| ml
    ml -->|"4"| px4
    px4 -->|"5"| ml
    ml -->|"6"| vi
    ml -->|"7"| app
    app -->|"8"| lm
    app -->|"8"| am
    app -->|"9"| user

