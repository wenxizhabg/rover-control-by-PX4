---
title: Sơ đồ lớp – kiến trúc 4 tầng, Sprint 3 (US-01, US-04, US-02, US-03a, US-03b) – chú thích và định nghĩa API tại docs/diagrams/class/class.txt
---
classDiagram
    direction TB

    %% Tầng 1 – Ứng dụng (rover/__main__.py, rover/app.py): điểm vào và vòng lặp chính; gọi xuống tầng 2 và tầng 3; chỉ run_app tạo driver tầng 4
    namespace Tang1_app {
        class main {
            <<module __main__.py>>
        }
        class app {
            <<module app.py>>
            +run_app() int
        }
        class RoverApp {
            -terminal: Terminal
            -clock: Clock
            -link: VehicleLink | None
            -show_help: bool
            -link_monitor: LinkMonitor
            -arm_control: ArmControl
            -drive: DriveController
            -messages: MessageBoard
            +step() bool
            +run() int
        }
    }

    %% Tầng 2 – Xử lý (rover/core/): Python thuần, không biết MAVLink, curses, đồng hồ thật; thời điểm now truyền từ ngoài vào
    namespace Tang2_core {
        class view {
            <<module core/view.py>>
            +KEY_BINDINGS: list
            +MESSAGE_HOLD_S: float = 0.5
            +action_for(key) Action | None
            +help_lines() list~str~
            +render(view) list~str~
            +format_link_status(state, count, seconds) str
            +format_arm_status(armed) str
            +format_drive_status(action, remaining_s) str
        }
        class ViewModel {
            <<dataclass>>
            +status_lines: list~str~
            +message: str
            +show_help: bool
            +help_lines: list~str~
        }
        class MessageBoard {
            -hold_s: float = MESSAGE_HOLD_S
            -queue: deque~str~
            +post(text, now) None
            +current(now) str
        }
        class LinkMonitor {
            <<core/vehicle.py>>
            +timeout_s: float = LINK_TIMEOUT_S 3.0
            +heartbeat_count: int
            +on_heartbeat(now) None
            +state(now) LinkState
            +seconds_since_last(now) float | None
        }
        class ArmControl {
            <<core/vehicle.py>>
            +armed: bool | None
            +on_heartbeat(armed) None
            +request(arm, link_state) tuple
            +on_ack(ack) str
        }
        class DriveController {
            <<core/vehicle.py>>
            +duration_s: float = DRIVE_DURATION_S 1.0
            +drive_speed: float = DRIVE_SPEED
            +turn_speed: float = TURN_SPEED
            +start(action, now) None
            +stop() None
            +setpoint(now) tuple
            +active_action(now) Action | None
            +remaining_s(now) float
        }
    }

    %% Tầng 3 – Trừu tượng (rover/hal.py, giống HAL): chỉ chữ ký hàm, không có xử lý
    namespace Tang3_hal {
        class VehicleLink {
            <<interface>>
            +poll() list~VehicleEvent~
            +send_arm(arm) None
            +send_drive(forward, turn) None
            +send_manual_mode() None
            +close() None
        }
        class Terminal {
            <<interface>>
            +read_key() str | None
            +draw(lines) None
            +close() None
        }
        class Clock {
            <<interface>>
            +now() float
        }
    }

    %% Tầng 4 – Driver (rover/drivers/): hiện thực interface tầng 3; chỉ tầng này dùng pymavlink, curses, time
    namespace Tang4_drivers {
        class mavlink {
            <<module drivers/mavlink.py>>
            +DEFAULT_URL: str = udpin 0.0.0.0 14540
            +PX4_MAIN_MODE_MANUAL: int = 1
            +MANUAL_Z_NEUTRAL: int = 500
            +parse_heartbeat(msg) VehicleInfo | None
        }
        class MavlinkVehicleLink {
            +conn
            +last_system_id: int | None
            +last_component_id: int | None
            +poll() list~VehicleEvent~
            +send_arm(arm) None
            +send_drive(forward, turn) None
            +send_manual_mode() None
            +close() None
        }
        class CursesTerminal {
            <<drivers/terminal.py>>
            -stdscr
            +read_key() str | None
            +draw(lines) None
            +close() None
        }
        class SystemClock {
            <<drivers/terminal.py>>
            +now() float
        }
    }

    %% Kiểu dữ liệu dùng chung cho mọi tầng (rover/core/model.py)
    namespace Types_core_model {
        class LinkState {
            <<enumeration>>
            WAITING
            CONNECTED
            LOST
        }
        class Action {
            <<enumeration>>
            TOGGLE_HELP
            QUIT
            ARM
            DISARM
            FORWARD
            BACKWARD
            TURN_LEFT
            TURN_RIGHT
            STOP
        }
        class Heartbeat {
            <<dataclass>>
            +info: VehicleInfo
            +armed: bool
        }
        class ArmAck {
            <<dataclass>>
            +accepted: bool
        }
        class VehicleInfo {
            <<dataclass>>
            +system_id: int
            +component_id: int
            +autopilot: str
            +vehicle_type: str
        }
    }

    %% Tầng 1: điểm vào, tạo driver, sở hữu các bộ xử lý tầng 2, nhận interface tầng 3
    main ..> app : gọi run_app
    app ..> RoverApp : tạo và chạy
    app ..> MavlinkVehicleLink : tạo
    app ..> CursesTerminal : tạo
    app ..> SystemClock : tạo
    RoverApp *-- LinkMonitor
    RoverApp *-- ArmControl
    RoverApp *-- DriveController
    RoverApp *-- MessageBoard
    RoverApp o-- VehicleLink
    RoverApp o-- Terminal
    RoverApp o-- Clock
    RoverApp ..> view : action_for, render, format_...
    view ..> ViewModel

    %% Tầng 4 hiện thực tầng 3
    MavlinkVehicleLink ..|> VehicleLink
    CursesTerminal ..|> Terminal
    SystemClock ..|> Clock
    MavlinkVehicleLink ..> mavlink : parse_heartbeat, hằng số

    %% Kiểu dữ liệu đi qua các tầng
    VehicleLink ..> Heartbeat : poll trả về
    VehicleLink ..> ArmAck : poll trả về
    Heartbeat *-- VehicleInfo
    LinkMonitor ..> LinkState
    ArmControl ..> ArmAck
    DriveController ..> Action
    view ..> Action
